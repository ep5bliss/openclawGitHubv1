# ──────────────────────────────────────────────
# AI Receptionist — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Your Business ─────────────────────────────
BUSINESS_NAME="Acme Consulting"
BUSINESS_TYPE="business consulting"
BUSINESS_HOURS="Monday to Friday, 9 AM to 5 PM Eastern"
OWNER_NAME="Jane"

# Name the AI receptionist will introduce itself as
RECEPTIONIST_NAME="Alex"

# ── Twilio ────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15550001234

# Voice used for text-to-speech (Polly voices via Twilio)
# Options: Polly.Joanna, Polly.Matthew, Polly.Amy, Polly.Brian, etc.
TWILIO_VOICE=Polly.Joanna

# How long to wait (seconds) for the caller to finish speaking
SPEECH_TIMEOUT_SECONDS=3

# ── Anthropic / Claude ────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Calendar (optional) ────────────────
# If not set, appointments are saved locally to data/appointments.json only.
#
# Setup:
#   1. Go to https://console.cloud.google.com
#   2. Create a project → enable "Google Calendar API"
#   3. IAM & Admin → Service Accounts → Create a service account
#   4. Download the JSON key and put it somewhere safe
#   5. In Google Calendar → Settings → Share with your service account email
#      and give it "Make changes to events" permission
#   6. Copy the Calendar ID from Calendar Settings → Integrate calendar

GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_CALENDAR_ID=your.email@gmail.com

# Duration of each appointment slot (minutes)
APPOINTMENT_DURATION_MINUTES=30

# ── Server ────────────────────────────────────
PORT=3000
