# ──────────────────────────────────────────────
# AI Receptionist — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Your Business ─────────────────────────────
BUSINESS_NAME="Acme Consulting"
BUSINESS_TYPE="business consulting"
BUSINESS_HOURS="Monday to Friday, 9 AM to 5 PM Eastern"
OWNER_NAME="Jane"

# Name the AI introduces itself as
RECEPTIONIST_NAME="Alex"

# ── Server ────────────────────────────────────
# Public URL where this server is hosted (no trailing slash)
# Used by the Vapi assistant to send webhook events
SERVER_URL=https://your-domain.com
PORT=3000

# ── Vapi ──────────────────────────────────────
# Sign up at https://vapi.ai — free trial available
# API key from: https://dashboard.vapi.ai/keys
VAPI_API_KEY=your_vapi_api_key_here

# Set automatically after running: npm run setup
VAPI_ASSISTANT_ID=

# ── OpenAI ────────────────────────────────────
# Get from https://platform.openai.com/api-keys
# Paste this key into Vapi's dashboard under Provider Keys > OpenAI
# (Vapi uses it directly — you don't need it here in .env)
#
# Model used for the AI conversation
OPENAI_MODEL=gpt-4o

# Voice for text-to-speech
# Options: alloy, echo, fable, onyx, nova, shimmer, ash, coral, sage
# nova = bright, feminine  |  onyx = deep, masculine  |  alloy = neutral
OPENAI_VOICE=nova

# ── Google Calendar (optional) ────────────────
# Without this, appointments are saved to data/appointments.json only.
#
# Setup steps:
#   1. https://console.cloud.google.com → create project → enable Google Calendar API
#   2. IAM & Admin → Service Accounts → Create → download JSON key
#   3. Save the JSON key as google-service-account.json in this directory
#   4. In Google Calendar → Settings → Share your calendar with the service account email
#      Permission: "Make changes to events"
#   5. Copy the Calendar ID from Calendar Settings → Integrate calendar

GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_CALENDAR_ID=your.email@gmail.com

# Appointment slot length in minutes
APPOINTMENT_DURATION_MINUTES=30
